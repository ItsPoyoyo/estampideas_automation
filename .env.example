# Trello OAuth 2.0 — usado pelo botão Conectar Trello
TRELLO_OAUTH_CLIENT_ID=
TRELLO_OAUTH_CLIENT_SECRET=

# Preenchidos automaticamente após autorizar o Trello
TRELLO_ACCESS_TOKEN=
TRELLO_TOKEN_EXPIRES_AT=0

# Alternativa ao OAuth: chave e token legados
TRELLO_API_KEY=
TRELLO_TOKEN=

# Quadros privados de teste; modelos opcionais em JSON: {"NOME DO MODELO":"ID"}
TRELLO_DIGITAL_BOARD_ID=
TRELLO_SUBLIMACAO_BOARD_ID=
TRELLO_TEMPLATE_IDS={}

# IDs curtos e completos de quadros proibidos, separados por vírgulas
TRELLO_BLOCKED_BOARD_IDS=

# IA opcional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Feriados opcionais: datas YYYY-MM-DD separadas por vírgulas
HOLIDAYS=

# Acompanhamento dos checklists de produção
PRODUCTION_AUTOMATION=true
